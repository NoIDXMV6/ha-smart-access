{
  "name": "Smart Access Core",
  "version": "1.1.2",
  "slug": "smart-access-core",
  "description": "Умный допуск на одной VM с HAOS: авто-открытие шлагбаумов по своим машинам и калитки по лицам. LLM — только внешний URL+token+модель (опционально).",
  "url": "https://github.com/NoIDXMV6/ha-smart-access",
  "image": "ghcr.io/noidxmv6/smart-access-core-{arch}",
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "host_network": true,
  "services": ["mqtt:want"],
  "ports": {
    "8099/tcp": 8099,
    "8100/tcp": 8100
  },
  "ports_description": {
    "8099/tcp": "Web-интерфейс и API (статус, база «своих», генератор конфига Frigate)",
    "8100/tcp": "MJPEG-мост для камер без RTSP (вход для Frigate, localhost)"
  },
  "webui": "http://[HOST]:[PORT:8099]",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:shield-car",
  "panel_title": "Smart Access",
  "panel_admin": true,
  "map": ["media:rw", "share:rw"],
  "options": {
    "master_enable": true,
    "frigate_url": "http://127.0.0.1:5000",
    "mqtt": {
      "host": "",
      "port": 1883,
      "user": "",
      "password": ""
    },
    "cameras": [
      {
        "name": "govorovo",
        "ha_entity": "camera.1_shlagbaum_derevnia_govorovo_15072_kamera",
        "mode": "car",
        "rtsp_url": "",
        "executor_service": "amvideo.open_barrier",
        "executor_target": "",
        "cooldown": 45,
        "schedule": "",
        "enabled": true
      }
    ],
    "recognition": {
      "car_threshold": 0.76,
      "car_gray_zone": 0.06,
      "face_threshold": 0.363,
      "min_confirm_frames": 2,
      "bridge_fps": 1.5,
      "unknown_keep_days": 7
    },
    "vlm": {
      "enabled": false,
      "base_url": "http://192.168.1.50:11434/v1",
      "api_key": "ollama",
      "model": "moondream",
      "timeout_sec": 6
    }
  },
  "schema": {
    "master_enable": "bool",
    "frigate_url": "url",
    "mqtt": {
      "host": "str?",
      "port": "port?",
      "user": "str?",
      "password": "password?"
    },
    "cameras": [
      {
        "name": "str",
        "ha_entity": "str",
        "mode": "list(car|face|car+face|off)",
        "rtsp_url": "str?",
        "executor_service": "str?",
        "executor_target": "str?",
        "cooldown": "int(5,600)?",
        "schedule": "str?",
        "enabled": "bool?"
      }
    ],
    "recognition": {
      "car_threshold": "float(0.5,0.95)?",
      "car_gray_zone": "float(0.01,0.2)?",
      "face_threshold": "float(0.2,0.6)?",
      "min_confirm_frames": "int(1,3)?",
      "bridge_fps": "float(0.5,5)?",
      "unknown_keep_days": "int(1,30)?"
    },
    "vlm": {
      "enabled": "bool",
      "base_url": "str?",
      "api_key": "password?",
      "model": "str?",
      "mode": "list(off|gray_zone|verify_all)?",
      "timeout_sec": "int(2,30)?"
    }
  }
}
